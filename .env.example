# Copy to .env and adjust as needed.
GUM_ENV=development
DATABASE_URL=postgresql+psycopg2://gum:gum@localhost:5432/gum
CHECK_DB_ON_STARTUP=true
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Milestone 2 — provider infrastructure (default: always mock / no paid calls)
GUM_FORCE_MOCK_PROVIDERS=true
GUM_PROVIDER_CACHE_ENABLED=true
GUM_PROVIDER_CACHE_TTL_SECONDS=300

# Optional credentials (unused while force-mock is true; M2 adapters stay stubbed)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_TRENDS_ENABLED=false
# SerpAPI key powers live Google organic SERP + Google Trends (never commit .env).
SERPAPI_API_KEY=
# SERP_API_BASE_URL=https://serpapi.com
# Paste your X (Twitter) API bearer token locally after copying this file to .env (never commit .env).
X_API_BEARER_TOKEN=
# X_API_BASE_URL=https://api.x.com/2
# YouTube Data API v3 key (never commit .env).
YOUTUBE_API_KEY=
# YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
